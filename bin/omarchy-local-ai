#!/usr/bin/env bash

# omarchy:summary=Run validated registry models on detected local hardware
# omarchy:args=<scan|download|run|unload|open-agent|switch>

set -euo pipefail
AI_ROOT=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
source "$AI_ROOT/lib/core.sh"

usage() {
  echo 'Usage: omarchy-local-ai <command>

  scan                   refresh registry and scan hardware
  download <model>       download one registry model
  run <model>            load one downloaded model
  unload                 free hardware; keep downloads
  open-agent             open the Omarchy agent picker
  switch <model>         atomically replace the running model'
}

command=${1:-help}; shift || true
if [[ $command =~ ^(scan|download|run|unload|switch)$ ]]; then
  mkdir -p "$AI_STATE"; exec 9>"$AI_STATE/operation.lock"
  flock -n 9 || fail "another local AI operation is running"
fi
case "$command" in
  scan) sync_registry >&2; snapshot_json ;;
  snapshot) snapshot_json ;;
  download) [[ -n ${1:-} ]] || fail 'choose a model'; download_recipe "$1" ;;
  run)
    wanted=${1:-}
    if [[ -z $wanted ]]; then
      wanted=$(registry_snapshot_json | jq -r '.models[]|select(.compatible)|[.id,(if .ready then "ready" else "busy" end),.precision,.engine]|@tsv' \
        | gum choose --header 'Local AI · choose a model' | cut -f1)
    fi
    [[ -n $wanted ]] && run_recipe "$wanted"
    ;;
  switch) [[ -n ${1:-} ]] || fail 'choose a model'; run_recipe "$1" ;;
  unload) unload_model ;;
  open-agent) exec omarchy-agent --pick ;;
  status)
    data=$(status_json)
    if [[ ${1:-} == --json ]]; then jq . <<<"$data"; else jq -r '"\(.state)" + (if .model then " · \(.model) · 127.0.0.1:\(.port)" else "" end)' <<<"$data"; fi
    ;;
  downloads)
    data=$(downloads_json)
    if [[ ${1:-} == --json ]]; then jq . <<<"$data"; else jq -r '.[]|"\(.model) · image " + (if .imageDownloaded then "ready" else "missing" end) + " · model " + (if .modelDownloaded then "ready" else ((.localBytes/1073741824|floor|tostring)+"/"+(.expectedBytes/1073741824|ceil|tostring)+" GB") end)' <<<"$data"; fi
    ;;
  task) task_model "$*" ;;
  benchmark) benchmark_model ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
