#!/bin/bash
# Reverse exactly what setup did.
set -euo pipefail
source "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/local-ai.sh"
image=$(engine_purge)
model_unwire_agents
model_forget
local_ai_notify_shell
echo "Local AI has been removed."
[[ -n $image ]] && echo "The engine image was kept; reclaim the space with: docker rmi $image"
