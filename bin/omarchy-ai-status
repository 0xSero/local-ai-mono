#!/bin/bash
# 0 running · 1 stopped · 2 not set up
set -euo pipefail
source "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/local-ai.sh"
case "$(engine_state)" in
  not-setup) echo "not set up"; exit 2 ;;
  running)   echo "$(model_active_name) on 127.0.0.1:$(jq -r '.port' <<<"$(model_active)")" ;;
  stopped)   echo "stopped"; exit 1 ;;
esac
