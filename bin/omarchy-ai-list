#!/bin/bash

# omarchy:summary=List pinned local AI recipes and serving state
# omarchy:group=ai
# omarchy:args=[--json]

set -euo pipefail
source "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/local-ai.sh"

vrams=$(hw_vram_json)
state=$(engine_state)
active=$(model_active_name)

listing=$(registry_recipes | jq --argjson vrams "$vrams" --arg active "$active" --arg state "$state" \
  --arg model "$(model_active_served_name)" --argjson port "$(registry_port)" '{
    vram_mb: ($vrams | max // 0), gpus: $vrams, state: $state, active: $active,
    model: $model, port: $port,
    recipes: map(. as $r | {
      name, label, min_vram_mb, min_gpus: (.min_gpus // 1),
      source: (.source // "built-in"),
      fits: (([$vrams[] | select(. >= $r.min_vram_mb)] | length) >= ($r.min_gpus // 1)),
      active: (.name == $active)
    })
  }')

if [[ ${1:-} == "--json" ]]; then
  jq . <<<"$listing"
else
  echo "state: $state${active:+ ($active)} · GPUs: $(jq -r '.gpus | length' <<<"$listing")× up to $(($(hw_largest_vram_mb) / 1024)) GB"
  jq -r '.recipes[] |
    (if .active then "●" elif .fits then "○" else "·" end) + " " +
    (.name | . + (" " * ([26 - length, 1] | max))) + " " + .label +
    "  — needs \(if .min_gpus > 1 then "\(.min_gpus)× " else "" end)\(.min_vram_mb / 1024 | ceil) GB" +
    (if .fits then "" else " (does not fit)" end) + "  [\(.source)]"' <<<"$listing"
fi
