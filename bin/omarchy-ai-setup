#!/bin/bash
# Serve a model sized to this machine and wire it into the agents.
set -euo pipefail
source "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/local-ai.sh"

dry_run=false; wanted=""
for arg in "$@"; do
  if [[ $arg == "--dry-run" ]]; then dry_run=true; else wanted=$arg; fi
done

hw_require_gpu || exit 1
vrams=$(hw_vram_json)

if [[ -n $wanted ]]; then
  recipe=$(model_resolve "$wanted" "$vrams") || exit 1
else
  if ! recipe=$(model_autopick "$vrams"); then
    echo "This machine has $(($(hw_largest_vram_mb) / 1024)) GB of VRAM; the smallest recipe needs 24 GB." >&2
    exit 1
  fi
fi

port=$(registry_port)
label=$(jq -r '.label' <<<"$recipe")
served=$(jq -r '.served_name // ""' <<<"$recipe")

if $dry_run; then
  echo "docker $(engine_plan "$recipe" "$port" | tr '\n' ' ')"
  exit 0
fi

echo "This machine has $(($(hw_largest_vram_mb) / 1024)) GB of VRAM, serving: $label"
engine_bootstrap || exit 1
echo "Starting the model server (pulls the engine image on first run)..."
engine_run "$recipe" "$port"
echo "Waiting for the model to load (~$(jq -r '.weights_gb // "several"' <<<"$recipe") GB download on first run)..."
echo "Follow along in another terminal with: omarchy ai logs"
engine_wait "$port" || exit 1
engine_verify "$port" "$served" || exit 1

model_record "$recipe" "$port"
model_wire_agents "$recipe" "$port"
omarchy-bar put omarchy.local-ai --after omarchy.system-update &>/dev/null || true
local_ai_notify_shell
omarchy-notification-send -g 󰚩 "Local AI ready" "$label is serving on port $port" 2>/dev/null || true

cat <<SUMMARY

Local AI is ready.

  Model     $label
  Endpoint  http://127.0.0.1:$port/v1 (OpenAI-compatible)
  Agents    pi and omp gained a "local" provider
SUMMARY
