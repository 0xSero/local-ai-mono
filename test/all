#!/usr/bin/env bash

set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
export OMARCHY_AI_USER_HOME="$TMP/user" OMARCHY_AI_STATE="$TMP/state" OMARCHY_AI_CACHE="$TMP/cache" OMARCHY_AI_REGISTRY="$TMP/registry"
export OMARCHY_AI_HARDWARE_JSON='{"groups":[{"backend":"nvidia","product":"NVIDIA GeForce RTX 3090","count":4,"memoryBytesEach":25769803776,"devices":[{"index":0,"totalMiB":24576,"freeMiB":23000},{"index":1,"totalMiB":24576,"freeMiB":23000},{"index":2,"totalMiB":24576,"freeMiB":23000},{"index":3,"totalMiB":24576,"freeMiB":23000}]}],"dockerReady":true,"diskFreeBytes":999999999999}'
mkdir -p "$OMARCHY_AI_USER_HOME" "$OMARCHY_AI_STATE" "$OMARCHY_AI_CACHE" "$OMARCHY_AI_REGISTRY"/{assets,hardware,model,model-instance,recipe,speed-sweeps}; touch "$OMARCHY_AI_REGISTRY/assets/config.yml"

digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
revision=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
jq -n '{schema_version:"local-ai-registry/v1",id:"rtx-3090-24gb",name:"GeForce RTX 3090",vendor:"nvidia",accelerator_backend:"nvidia",memory:{vram_gb:24},aliases:["rtx 3090"]}' >"$OMARCHY_AI_REGISTRY/hardware/rtx-3090-24gb.json"
jq -n '{schema_version:"local-ai-registry/v1",id:"small",name:"Small Registry Model"}' >"$OMARCHY_AI_REGISTRY/model/small.json"
jq -n --arg revision "$revision" '{schema_version:"local-ai-registry/v1",id:"org-small--bf16",model_id:"small",repository:"org/small",revision:$revision,weights:{format:"safetensors",precision:"BF16",size_gb:0.0000001}}' >"$OMARCHY_AI_REGISTRY/model-instance/org-small--bf16.json"
jq -n --arg digest "$digest" '{schema_version:"local-ai-registry/v1",id:"small-3090",status:"validated",model_instance_id:"org-small--bf16",hardware_id:"rtx-3090-24gb",hardware_count:1,
  engine:{name:"sglang",version:"test",graph_mode:"full"},launch:{kind:"docker",image:("image@sha256:"+$digest),container_port:30000,entrypoint:"/bin/server",ipc:"host",shm_size:"1g",environment:{A:"B"},mounts:[{source:"~/.cache/huggingface",target:"/root/.cache/huggingface",read_only:false},{source:"assets/config.yml",target:"/app/config.yml",read_only:true}],arguments:["--model","org/small"]},
  serving:{max_context_tokens:8192,tensor_parallel:1},capabilities:{chat:true,reasoning:false,tools:false,vision:false},speed_sweeps_ids:["small-sweep"]}' >"$OMARCHY_AI_REGISTRY/recipe/small-3090.json"
jq -n '{schema_version:"local-ai-registry/v1",id:"small-sweep",recipe_id:"small-3090",rows:[{status:"accepted",decode_tok_s:42.5}]}' >"$OMARCHY_AI_REGISTRY/speed-sweeps/small-sweep.json"
jq -n '{schema_version:"local-ai-registry/v1",recipes:[{id:"small-3090",status:"validated",model_instance_id:"org-small--bf16",hardware_id:"rtx-3090-24gb",hardware_count:1,engine:"sglang",launch_kind:"docker",has_evidence:true}]}' >"$OMARCHY_AI_REGISTRY/index.json"

source "$ROOT/lib/core.sh"
pass=0
ok() { pass=$((pass+1)); printf 'ok %s - %s\n' "$pass" "$1"; }
assert() { "$@" || { printf 'not ok - %s\n' "$*" >&2; exit 1; }; }

assert registry_valid; ok 'canonical registry index validates'
snapshot=$(registry_snapshot_json)
assert jq -e '.schemaVersion=="local-ai-registry/v1" and .registry.recipeCount==1 and .models[0].name=="Small Registry Model" and .models[0].registrySpeed==42.5 and .hardware.groups[0].registryId=="rtx-3090-24gb"' >/dev/null <<<"$snapshot"
ok 'hardware and model names come only from referenced registry records'

recipe=$(recipe_json small); plan=$(plan_json "$recipe")
assert jq -e --arg asset "$(realpath "$OMARCHY_AI_REGISTRY/assets/config.yml"):/app/config.yml:ro" '.argv|index("127.0.0.1:12434:30000") and index("device=0") and index($asset) and index("image@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")' >/dev/null <<<"$plan"
assert jq -e '[.argv[]|select(test("enforce.eager|disable.*cuda.*graph";"i"))]|length==0' >/dev/null <<<"$plan"
ok 'launch plan is digest-pinned, loopback-only, and keeps CUDA graphs'

intel=$(jq '.compatibility.acceleratorBackend="intel-xpu" | .launch.devices=["/dev/dri"] | .launch.capAdd=["SYS_PTRACE"] | .launch.securityOpt=["seccomp=unconfined"]' <<<"$recipe"); plan=$(plan_json "$intel")
assert jq -e '.argv|index("/dev/dri:/dev/dri") and index("SYS_PTRACE") and index("seccomp=unconfined")' >/dev/null <<<"$plan"
ok 'Intel Docker plan preserves the validated device and security contract'
if plan_json "$(jq '.compatibility.acceleratorBackend="intel-xpu" | .launch.capAdd=["NET_ADMIN"]' <<<"$recipe")" >/dev/null 2>&1; then printf 'not ok - unsafe capability accepted\n' >&2; exit 1; fi
ok 'registry cannot request arbitrary container capabilities'

download=$(download_plan_json "$recipe")
assert jq -e '
  .pull == ["docker","pull","image@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
  and (.fetch|index("--entrypoint")) and (.fetch|index("hf"))
  and (.fetch|index("org/small")) and (.fetch|index("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
  and ([.fetch[]|select(test("/root/.cache/huggingface"))]|length==1)
' >/dev/null <<<"$download"
ok 'download plan fetches the exact registry revision without starting a server'

gguf=$(jq '.model.servedName="/models/model.gguf" | .launch.mounts=[{source:"~/.cache/models",target:"/models",read_only:false}]' <<<"$recipe")
download=$(download_plan_json "$gguf")
assert jq -e '(.fetch|index("model.gguf")) and (.fetch|index("--local-dir")) and (.fetch|index("/models"))' >/dev/null <<<"$download"
ok 'GGUF downloads only the registry-declared file into the mounted model directory'

jq '.launch.arguments += ["--enforce-eager"]' "$OMARCHY_AI_REGISTRY/recipe/small-3090.json" >"$TMP/bad"; mv "$TMP/bad" "$OMARCHY_AI_REGISTRY/recipe/small-3090.json"
if resolved_recipe small-3090 "$(hardware_with_registry)" >/dev/null 2>&1; then printf 'not ok - unsafe registry recipe accepted\n' >&2; exit 1; fi
ok 'unsafe registry launch arguments are refused'
jq '.launch.arguments = ["--model","org/small"]' "$OMARCHY_AI_REGISTRY/recipe/small-3090.json" >"$TMP/good"; mv "$TMP/good" "$OMARCHY_AI_REGISTRY/recipe/small-3090.json"

mkdir -p "$OMARCHY_AI_USER_HOME/.cache/huggingface/hub/models--org--small"; dd if=/dev/zero of="$OMARCHY_AI_USER_HOME/.cache/huggingface/hub/models--org--small/weights.bin" bs=92 count=1 status=none
assert jq -e 'length==1 and .[0].model=="Small Registry Model" and .[0].modelDownloaded==true' >/dev/null <<<"$(downloads_json "$(registry_snapshot_json)")"
ok 'download state follows registry-declared cache mounts'

served_model() { printf 'org/small\n'; }
request_json() { jq -nc '{choices:[{message:{content:"LOCAL_AI_READY"}}]}'; }
assert accept_model "$recipe"
request_json() { jq -nc '{choices:[{message:{content:"wrong reply"}}]}'; }
if accept_model "$recipe"; then printf 'not ok - invalid readiness reply accepted\n' >&2; exit 1; fi
ok 'acceptance requires the requested readiness proof'

wire_agents "$(recipe_json small)"
assert jq -e '.providers.local.baseUrl=="http://127.0.0.1:12434/v1" and (.providers.local.models[0]|has("maxTokens")|not)' "$OMARCHY_AI_USER_HOME/.omp/agent/models.json" >/dev/null
assert ruby -ryaml -e 'd=YAML.safe_load(File.read(ARGV[0])); abort unless d.dig("modelRoles","default")=="omarchy-local/org/small"' "$OMARCHY_AI_USER_HOME/.omp/agent/config.yml"
unwire_agents; ok 'OMP and Pi wiring is minimal and reversible'

(
  calls="$TMP/switch-calls"
  recipe_json() { jq -nc '{id:"small-3090",ready:true,model:{name:"Small Registry Model"}}'; }
  registry_snapshot_json() { printf '{}\n'; }
  downloads_json() { jq -nc '[{id:"small-3090",modelDownloaded:true,imageDownloaded:true}]'; }
  plan_json() { jq -nc '{argv:["true"]}'; }
  accept_model() { return 1; }
  docker() {
    printf '%s\n' "$*" >>"$calls"
    if [[ $1 == inspect && ${2:-} == -f ]]; then [[ $3 == *Labels* ]] && echo 1 || echo true; fi
    return 0
  }
  set +e; run_recipe small >/dev/null 2>&1; switch_rc=$?; set -e
  [[ $switch_rc -ne 0 ]] || { printf 'not ok - failed switch reported success\n' >&2; exit 1; }
  assert grep -q '^stop omarchy-local-ai$' "$calls"
  assert grep -q '^rename omarchy-local-ai omarchy-local-ai-previous$' "$calls"
  assert grep -q '^rename omarchy-local-ai-previous omarchy-local-ai$' "$calls"
  assert grep -q '^start omarchy-local-ai$' "$calls"
)
ok 'failed switch restores and restarts the previous managed model'

assert jq -e '.id=="sero.local-ai" and .entryPoints.barWidget=="Panel.qml"' "$ROOT/manifest.json" >/dev/null
if grep -Eq 'Qwen|Gemma|LFM|Ornith|#[0-9A-Fa-f]{6}' "$ROOT/Panel.qml"; then printf 'not ok - panel embeds catalog data or fixed colors\n' >&2; exit 1; fi
assert grep -q 'BarIconButton {' "$ROOT/Panel.qml"
assert grep -q 'radius: width / 2' "$ROOT/Panel.qml"
assert grep -q 'Math.round(root.downloadProgress \* 100) + "%"' "$ROOT/Panel.qml"
for label in 'Scan' 'Download' 'Run' 'Unload' 'Open agent' 'Switch running model'; do assert grep -q "$label" "$ROOT/Panel.qml"; done
ok 'theme-native panel has a circular icon, progress state, and all six lifecycle actions'

help=$("$ROOT/bin/omarchy-local-ai" --help)
for command in scan download run unload open-agent switch; do assert grep -q "$command" <<<"$help"; done
ok 'CLI presents the same six-action contract as the panel'

docker() { return 1; }
flock() { return 0; }
export -f docker flock
scan=$("$ROOT/bin/omarchy-local-ai" scan 2>/dev/null)
assert jq -e '.models[0].name=="Small Registry Model" and .hardware.groups[0].count==4 and .status.ready==false' >/dev/null <<<"$scan"
unset -f docker flock
ok 'scan integrates registry, mocked hardware, downloads, and runtime state without GPU access'

for file in "$ROOT"/bin/* "$ROOT"/lib/*.sh "$ROOT"/test/all; do bash -n "$file"; done
lines=$(find "$ROOT" -type f -not -path '*/.git/*' -not -name '.DS_Store' -print0 | xargs -0 wc -l | tail -1 | awk '{print $1}')
((lines <= 1000)) || { printf 'not ok - %s lines exceeds 1000\n' "$lines" >&2; exit 1; }
ok "repository stays compact ($lines lines)"

printf '1..%s\n' "$pass"
